# PostgreSQL (Nebula SaaS)
DATABASE_URL=postgres://nebula:nebula@localhost:5432/nebula_dev

# API
PORT=4000
NODE_ENV=development
# Alleen 0.0.0.0 nodig in Docker/public — anders blijft 127.0.0.1 (lokaal veiliger)
# LISTEN_HOST=0.0.0.0

# Release-manifest voor SaaS-downloads (GET /v1/releases/latest). Standaard: webapp/public/releases/nebula-release-manifest.json
# RELEASE_MANIFEST_PATH=/absoluut/pad/naar/nebula-release-manifest.json
# Of inline JSON (serverless): RELEASE_MANIFEST_JSON={"product":"Nebula",...}

# CORS: in productie exacte frontend-URL (geen *). Lokaal: leeg laten = * voor /v1/releases
# CORS_ORIGIN=https://app.jouwdomein.com

# Rate limit (publieke routes, per IP, in-memory)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120
# RATE_LIMIT_HEALTH_MAX=300

# Achter reverse proxy: client-IP uit X-Forwarded-For
# TRUST_PROXY=1

# Alleen als je overal HTTPS hebt en HSTS wilt
# ENABLE_HSTS=1

# Beheer + tenants: zelfde sleutel (Authorization: Bearer … of X-Internal-Key)
# Activeert o.a. GET/PUT /v1/admin/platform-config (centrale SaaS-instellingen) en beschermt GET /v1/tenants.
# INTERNAL_API_KEY=kies-een-lange-willekeurige-string

# Optioneel: andere map voor platform-config.json (default: backend/data/)
# PLATFORM_DATA_DIR=/var/lib/nebula

# Later: JWT_SECRET, STRIPE_*, OPENAI_API_KEY, etc.
